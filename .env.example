# cpp-http-server — Environment Variables
#
# Copy this file to .env and set your values.
# ENV variables take precedence over config.json settings.
#
# Format: NAME=VALUE (no spaces around =)

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Server bind address. Default: 0.0.0.0
SERVER_HOST=0.0.0.0

# Server listen port. Default: 8080
SERVER_PORT=8080

# Maximum HTTP request body size in bytes. Default: 16777216 (16 MB)
SERVER_MAX_REQUEST_BODY_SIZE=16777216

# Server read timeout in milliseconds. Default: 30000 (30s)
SERVER_READ_TIMEOUT_MS=30000

# Server write timeout in milliseconds. Default: 30000 (30s)
SERVER_WRITE_TIMEOUT_MS=30000

# Keep-alive idle timeout in milliseconds. Time to wait for the next request
# on an existing connection before closing it. Default: 5000 (5s)
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000

# Maximum concurrent connections. 0 = unlimited. Default: 1024
SERVER_MAX_CONNECTIONS=1024

# Maximum requests per keep-alive connection. Default: 100
SERVER_MAX_REQUESTS_PER_CONNECTION=100

# =============================================================================
# HTTP CLIENT SETTINGS (outgoing requests)
# =============================================================================

# Connect timeout for outgoing HTTP requests in milliseconds. Default: 5000 (5s)
HTTP_CLIENT_CONNECT_TIMEOUT_MS=5000

# Read timeout for outgoing HTTP requests in milliseconds. Default: 30000 (30s)
HTTP_CLIENT_READ_TIMEOUT_MS=30000

# Write timeout for outgoing HTTP requests in milliseconds. Default: 30000 (30s)
HTTP_CLIENT_WRITE_TIMEOUT_MS=30000

# =============================================================================
# CIRCUIT BREAKER SETTINGS (prefixed by usage, e.g. HTTP_BROKER_)
# =============================================================================

# Number of consecutive failures before opening circuit. Default: 5
# HTTP_CB_FAILURE_THRESHOLD=5

# Time to wait before transitioning from OPEN to HALF_OPEN (ms). Default: 30000
# HTTP_CB_RESET_TIMEOUT_MS=30000

# Number of successful calls in HALF_OPEN to close the circuit. Default: 3
# HTTP_CB_HALF_OPEN_MAX_CALLS=3

# =============================================================================
# RETRY SETTINGS (prefixed by usage, e.g. HTTP_BROKER_)
# =============================================================================

# Max retry attempts. Default: 3
# HTTP_BROKER_RETRY_MAX_ATTEMPTS=3

# Base delay in milliseconds. Default: 1000
# HTTP_BROKER_RETRY_BASE_DELAY_MS=1000

# Backoff multiplier. Default: 2.0
# HTTP_BROKER_RETRY_MULTIPLIER=2.0

# Max delay in milliseconds. Default: 30000
# HTTP_BROKER_RETRY_MAX_DELAY_MS=30000

# Retryable HTTP status codes (comma-separated). Default: 500,502,503,504
# HTTP_BROKER_RETRY_STATUSES=500,502,503,504

# Retry on network errors. Default: true
# HTTP_BROKER_RETRY_ON_NETWORK_ERROR=true

# =============================================================================
# SPLUNK LOGGING (via SplunkLogSettings)
# =============================================================================

# Prefix for all settings: use APP_, SERVICE_, etc.
# Example: APP_SPLUNK_URL, APP_SPLUNK_TOKEN

# Splunk HTTP Event Collector URL. Default: http://localhost:8088/services/collector
# APP_SPLUNK_URL=http://localhost:8088/services/collector

# Splunk HEC token (required for authentication)
# APP_SPLUNK_TOKEN=your-token-here

# Splunk index. Default: main
# APP_SPLUNK_INDEX=main

# Splunk sourcetype. Default: _json
# APP_SPLUNK_SOURCETYPE=_json

# Buffer size before forced flush. Default: 100
# APP_SPLUNK_BUFFER_SIZE=100

# Flush interval in seconds. Default: 5
# APP_SPLUNK_FLUSH_INTERVAL_SEC=5

# =============================================================================
# RABBITMQ SETTINGS
# =============================================================================

# RabbitMQ host. Default: localhost
RABBITMQ_HOST=localhost

# RabbitMQ port. Default: 5672
RABBITMQ_PORT=5672

# RabbitMQ username. Default: guest
RABBITMQ_USER=guest

# RabbitMQ password. Default: guest
RABBITMQ_PASSWORD=guest

# RabbitMQ exchange name. Default: events
RABBITMQ_EXCHANGE=events

# RabbitMQ queue name. Empty = server-generated exclusive queue. Default: (empty)
RABBITMQ_QUEUE_NAME=

# =============================================================================
# DATABASE SETTINGS (PostgreSQL) — use prefix, e.g. AUTH_DB_HOST, TRADING_DB_PORT
# =============================================================================

# Database host. Default: <prefix>-postgres (e.g., AUTH_DB_HOST defaults to auth-postgres)
DB_HOST=localhost

# Database port. Default: 5432
DB_PORT=5432

# Database name. Default: <prefix>_db (e.g., AUTH_DB_NAME defaults to auth_db)
DB_NAME=myapp

# Database user. Default: <prefix>_user (e.g., AUTH_DB_USER defaults to auth_user)
DB_USER=myapp_user

# Database password. Default: <prefix>_secret_password
DB_PASSWORD=myapp_password

# Minimum number of connections in the pool. Default: 2
DB_POOL_MIN_CONNECTIONS=2

# Maximum number of connections in the pool. Default: 10
DB_POOL_MAX_CONNECTIONS=10